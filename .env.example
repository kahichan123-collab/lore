# Copy to .env.local and fill in. Never commit .env.local.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# The "anon" or "publishable" key — safe in the browser; RLS protects the data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# The "service_role" or "secret" key — SERVER ONLY. Bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=

# Public URL of the site, used in magic-link emails. Omit locally.
# NEXT_PUBLIC_SITE_URL=https://lore.example.com

# Comma-separated emails that get /admin access. Apply with `npm run seed`.
ADMIN_EMAILS=you@example.com

# Anthropic — https://console.anthropic.com → API Keys. SERVER ONLY.
ANTHROPIC_API_KEY=
# Any current Claude model id. Default: claude-opus-5-5 (most capable).
# claude-haiku-5-5 is ~40x cheaper per token if budget is tight.
ANTHROPIC_MODEL=claude-opus-5-5
# AI Companion questions per user per 24 hours.
AI_DAILY_LIMIT=20

# Protects the weekly AI Insight job (/api/cron/insights). Any long random
# string; Vercel sends it automatically when set in the project's env vars.
CRON_SECRET=
