# 古問 LORE — environment variables
#
# Copy this file to `.env.local` and fill in the blanks:
#   cp .env.example .env.local
#
# `.env.local` is ignored by git. Never paste these values into a commit,
# a screenshot, a chat message or client-side code.

# ─────────────────────────────────────────────────────────────
# Supabase — Project Settings → API
# ─────────────────────────────────────────────────────────────

# Project URL, e.g. https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# The "anon" / "publishable" key. Safe in the browser: Row Level Security
# protects the data even though the key is public.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The "service_role" / "secret" key. SERVER ONLY — it bypasses RLS.
# Never add NEXT_PUBLIC_ to this name.
SUPABASE_SERVICE_ROLE_KEY=

# Public URL of the site. Used in magic-link emails and metadata.
# Local: http://localhost:3000. Production: https://your-domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─────────────────────────────────────────────────────────────
# AI — DeepSeek (OpenAI-compatible API)
# Docs: https://api-docs.deepseek.com
# All calls happen in server route handlers; the browser never sees the key.
# ─────────────────────────────────────────────────────────────

# DeepSeek's OpenAI-compatible base URL. Do not add /chat/completions.
AI_BASE_URL=https://api.deepseek.com

# DeepSeek API key from https://platform.deepseek.com/api_keys. SERVER ONLY.
AI_API_KEY=

# Chat model. Current names: deepseek-flash | deepseek-v4-pro.
AI_MODEL_CHAT=deepseek-flash

# Insight model. v4-pro gives better structured summaries; switch to
# deepseek-flash if cost matters more than quality.
AI_MODEL_INSIGHT=deepseek-v4-pro

# AI Companion questions per signed-in reader per 24 hours.
AI_DAILY_LIMIT_PER_USER=20

# ─────────────────────────────────────────────────────────────
# Admin and scheduled jobs
# ─────────────────────────────────────────────────────────────

# Comma-separated emails. Run `npm run seed` to register them and promote
# accounts that already signed up.
ADMIN_EMAILS=

# Random string that protects the weekly AI Insight job
# (/api/cron/insights). Vercel Cron sends it automatically.
CRON_SECRET=

# ─────────────────────────────────────────────────────────────
# Note
# ─────────────────────────────────────────────────────────────
# The AI routes use the DeepSeek variables above. If AI_API_KEY is empty, the
# rest of the site still works and the AI panel shows "not configured".
